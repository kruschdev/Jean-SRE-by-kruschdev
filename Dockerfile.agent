FROM node:22-slim

# Install python and dependencies for the MCP server
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv git \
    ca-certificates curl gnupg iputils-ping poppler-utils tesseract-ocr && \
    rm -rf /var/lib/apt/lists/*

# Install Docker CLI + Compose plugin for infra MCP
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
      > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y docker-ce-cli docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/*

# Add docker group and add node user to it
ARG DOCKER_GID=986
RUN groupadd -g ${DOCKER_GID} docker || true && usermod -aG docker node

WORKDIR /app
RUN chown node:node /app

# Ensure correct ownership for python venv
RUN mkdir -p /opt/venv && chown node:node /opt/venv

# Switch to non-root user
USER node

# Copy python requirements
COPY --chown=node:node projects/jean-sre/requirements-agent.txt ./
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements-agent.txt

# Copy and install lib-py (krusch-toolkit for Python)
COPY --chown=node:node lib-py /app/lib-py
RUN pip install -e /app/lib-py

# Copy toolkit, cascade-router, and agent package.json
COPY --chown=node:node lib /app/lib
COPY --chown=node:node projects/krusch-cascade-router /app/projects/krusch-cascade-router
COPY --chown=node:node projects/jean-sre/src/package.json ./
RUN npm install

# Copy application source
WORKDIR /app
COPY --chown=node:node projects/jean-sre/ ./projects/jean-sre/

# Set default envs
ENV APP_ROOT=/app/projects/jean-sre
ENV OLLAMA_URL=http://127.0.0.1:11435
ENV PYTHON_BIN=python3

WORKDIR /app/projects/jean-sre/src
CMD ["node", "harness.js"]
